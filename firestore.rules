rules_version = '2';
// Hackathon rules: anyone with a page id can read/write that page (ids are unguessable).
// Nothing else in the database is readable or writable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pages/{pageId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['snapshot', 'state', 'updated_at'])
                   && request.resource.data.snapshot is string
                   && request.resource.data.state.page_id == pageId;
    }
  }
}
