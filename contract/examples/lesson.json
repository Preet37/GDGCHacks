      "lesson": {
        "title": "Why the derivative of x² is 2x",
        "steps": [
          {
            "say": "A derivative tells you how steep a curve is at each point. Here is the curve y equals x squared.",
            "write": "f(x) = x^2",
            "caption": "The curve $y = x^2$",
            "visual": {
              "kind": "plot2d",
