# Firebase web config (Project settings -> Your apps -> Web app). Public by design; firestore.rules guards access.
# Copy to .env.local for dev or .env.production for the Firebase deploy. Leave empty = no cloud save.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
